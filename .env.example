# ========================================
# Docker Ports (only needed for docker-compose)
# ========================================
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ========================================
# NOTE: Most configuration is now in application.yml
# This file is optional for Docker environment variables only
# ========================================

# ========================================
# SMTP Configuration (optional - for production)
# Leave empty to use defaults in application.yml
# ========================================
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your@gmail.com
# SPRING_MAIL_PASSWORD=app-password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# ========================================
# Scheduler Configuration (optional)
# Default values are in application.yml
# ========================================
# APP_SCHEDULER_TIMEZONE=Asia/Kolkata
# APP_SCHEDULER_HOURLY_ENABLED=false
# APP_SCHEDULER_HOURLY_CRON=0 5 10-15 ? * MON-FRI
# APP_SCHEDULER_DAILY_ENABLED=false
# APP_SCHEDULER_DAILY_CRON=0 20 16 ? * MON-FRI

# ========================================
# Notification Configuration (optional)
# Default values are in application.yml
# ========================================
# APP_NOTIFICATION_RECIPIENTS=you@example.com
# APP_NOTIFICATION_FROM=alerts@yourdomain.com
# APP_NOTIFICATION_SENDER_NAME=Stock Signal Tracker
# APP_NOTIFICATION_HOURLY_INCLUDE_EMPTY=false
# APP_NOTIFICATION_DAILY_INCLUDE_EMPTY=true

# ========================================
# Scanner Configuration (optional)
# Default values are in application.yml
# ========================================
# APP_SCANNER_MAX_CONCURRENCY=12
# APP_MARKET_UNIVERSE_NSE_EQUITY_LIST_URL=https://archives.nseindia.com/content/equities/EQUITY_L.csv
# APP_MARKET_UNIVERSE_MAX_SYMBOLS=0

# ========================================
# Logging Configuration (optional)
# ========================================
# APP_LOG_LEVEL=INFO
# APP_LOG_FILE=./data/stock-tracker.log
