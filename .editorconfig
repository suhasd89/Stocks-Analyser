# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# 2 space indentation for web files
[*.{js,jsx,ts,tsx,css,html,json,yml,yaml}]
indent_style = space
indent_size = 2

# 4 space indentation for Java files
[*.{java}]
indent_style = space
indent_size = 4

# 2 space indentation for XML/POM files
[*.{xml,pom}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# Batch files
[*.{bat,cmd}]
end_of_line = crlf
