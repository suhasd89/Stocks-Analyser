//@version=6
indicator("HADC HA Swing Signals - Daily Positional", overlay=true, max_labels_count=500)

// Designed from the attached HADC-style signal guide:
// B = buy/hold buy trend, S = sell/hold sell trend, H = consolidation/partial profit,
// R = reversal risk/partial profit. Signals are intended for confirmed daily candles.

signalTimeframe = input.timeframe("D", "Signal timeframe")
fastLength = input.int(21, "Fast EMA length", minval=2)
slowLength = input.int(55, "Slow EMA length", minval=5)
dmiLength = input.int(14, "DMI length", minval=2)
adxSmoothing = input.int(14, "ADX smoothing", minval=2)
minAdx = input.float(18.0, "Minimum ADX for trend", minval=1.0, step=0.5)
strongBodyPercent = input.float(55.0, "Strong HA body %", minval=1.0, maxval=100.0, step=1.0)
holdBodyPercent = input.float(28.0, "Hold/consolidation body %", minval=1.0, maxval=100.0, step=1.0)
atrLength = input.int(14, "ATR stop length", minval=2)
atrMultiplier = input.float(2.5, "ATR reversal multiplier", minval=0.5, step=0.1)
showContinuationLabels = input.bool(true, "Show light B/S continuation labels")
showHoldLabels = input.bool(true, "Show H labels")
showReversalLabels = input.bool(true, "Show R labels")
colorPriceBars = input.bool(true, "Color price bars by signal")
showTrendCloud = input.bool(true, "Show EMA trend cloud")
showStatusTable = input.bool(true, "Show status table")

haTicker = ticker.heikinashi(syminfo.tickerid)
[haOpen, haHigh, haLow, haClose] = request.security(
     haTicker,
     signalTimeframe,
     [open, high, low, close],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
)

emaFast = ta.ema(haClose, fastLength)
emaSlow = ta.ema(haClose, slowLength)

haRange = math.max(haHigh - haLow, syminfo.mintick)
haBody = math.abs(haClose - haOpen)
haBodyPercent = haBody / haRange * 100.0
haBull = haClose > haOpen
haBear = haClose < haOpen
haStrong = haBodyPercent >= strongBodyPercent
haWeak = haBodyPercent <= holdBodyPercent

previousHaClose = nz(haClose[1], haClose)
haUpMove = haHigh - nz(haHigh[1], haHigh)
haDownMove = nz(haLow[1], haLow) - haLow
haPlusDm = haUpMove > haDownMove and haUpMove > 0.0 ? haUpMove : 0.0
haMinusDm = haDownMove > haUpMove and haDownMove > 0.0 ? haDownMove : 0.0
haTrueRange = math.max(haHigh - haLow, math.max(math.abs(haHigh - previousHaClose), math.abs(haLow - previousHaClose)))
haDmiRange = math.max(ta.rma(haTrueRange, dmiLength), syminfo.mintick)
plusDi = 100.0 * ta.rma(haPlusDm, dmiLength) / haDmiRange
minusDi = 100.0 * ta.rma(haMinusDm, dmiLength) / haDmiRange
dxValue = 100.0 * math.abs(plusDi - minusDi) / math.max(plusDi + minusDi, syminfo.mintick)
adxValue = ta.rma(dxValue, adxSmoothing)
atrValue = ta.rma(haTrueRange, atrLength)

longAtrLine = ta.highest(haClose, atrLength) - atrValue * atrMultiplier
shortAtrLine = ta.lowest(haClose, atrLength) + atrValue * atrMultiplier

bullSetup = haBull and haClose > emaFast and emaFast > emaSlow and plusDi > minusDi and adxValue >= minAdx
bearSetup = haBear and haClose < emaFast and emaFast < emaSlow and minusDi > plusDi and adxValue >= minAdx
consolidating = adxValue < minAdx or haWeak or math.abs(emaFast - emaSlow) / math.max(haClose, syminfo.mintick) * 100.0 < 0.35

var int trendState = 0
previousTrend = nz(trendState[1], 0)

longReversalRisk = previousTrend == 1 and (haBear and haClose < emaFast or minusDi > plusDi and adxValue >= minAdx or haClose < longAtrLine)
shortReversalRisk = previousTrend == -1 and (haBull and haClose > emaFast or plusDi > minusDi and adxValue >= minAdx or haClose > shortAtrLine)

if barstate.isconfirmed
    if bullSetup and (previousTrend <= 0 or haStrong)
        trendState := 1
    else if bearSetup and (previousTrend >= 0 or haStrong)
        trendState := -1
    else if longReversalRisk or shortReversalRisk
        trendState := 0
    else
        trendState := previousTrend

strongBuySignal = barstate.isconfirmed and trendState == 1 and previousTrend != 1
strongSellSignal = barstate.isconfirmed and trendState == -1 and previousTrend != -1
reversalSignal = barstate.isconfirmed and not strongBuySignal and not strongSellSignal and (longReversalRisk or shortReversalRisk)
holdSignal = barstate.isconfirmed and not strongBuySignal and not strongSellSignal and not reversalSignal and (trendState == 0 or consolidating)
buyHoldSignal = barstate.isconfirmed and trendState == 1 and previousTrend == 1 and not holdSignal and not reversalSignal
sellHoldSignal = barstate.isconfirmed and trendState == -1 and previousTrend == -1 and not holdSignal and not reversalSignal

deepGreen = color.rgb(0, 120, 55)
lightGreen = color.rgb(85, 190, 120)
deepRed = color.rgb(145, 25, 35)
lightRed = color.rgb(225, 105, 105)
holdColor = color.rgb(235, 170, 35)
reversalColor = color.rgb(85, 95, 215)
neutralColor = color.rgb(120, 120, 120)

plotshape(strongBuySignal, title="Strong Buy B", location=location.belowbar, color=deepGreen, style=shape.labelup, text="B", textcolor=color.white, size=size.small)
plotshape(showContinuationLabels and buyHoldSignal, title="Buy / Hold B", location=location.belowbar, color=lightGreen, style=shape.labelup, text="B", textcolor=color.white, size=size.tiny)
plotshape(strongSellSignal, title="Strong Sell S", location=location.abovebar, color=deepRed, style=shape.labeldown, text="S", textcolor=color.white, size=size.small)
plotshape(showContinuationLabels and sellHoldSignal, title="Sell / Hold S", location=location.abovebar, color=lightRed, style=shape.labeldown, text="S", textcolor=color.white, size=size.tiny)
plotshape(showReversalLabels and reversalSignal, title="Reversal Risk R", location=location.abovebar, color=reversalColor, style=shape.labeldown, text="R", textcolor=color.white, size=size.tiny)
plotshape(showHoldLabels and holdSignal, title="Hold / Consolidation H", location=location.top, color=holdColor, style=shape.labeldown, text="H", textcolor=color.black, size=size.tiny)

emaFastPlot = plot(showTrendCloud ? emaFast : na, title="HA Fast EMA", color=color.new(color.teal, 0), linewidth=1)
emaSlowPlot = plot(showTrendCloud ? emaSlow : na, title="HA Slow EMA", color=color.new(color.orange, 0), linewidth=1)
fill(emaFastPlot, emaSlowPlot, title="Trend Cloud", color=trendState == 1 ? color.new(deepGreen, 86) : trendState == -1 ? color.new(deepRed, 86) : color.new(neutralColor, 90))
plot(trendState == 1 ? longAtrLine : na, title="Long ATR Reversal Line", color=color.new(deepGreen, 35), style=plot.style_linebr)
plot(trendState == -1 ? shortAtrLine : na, title="Short ATR Reversal Line", color=color.new(deepRed, 35), style=plot.style_linebr)

barSignalColor = strongBuySignal ? deepGreen : buyHoldSignal ? lightGreen : strongSellSignal ? deepRed : sellHoldSignal ? lightRed : reversalSignal ? reversalColor : holdSignal ? holdColor : na
tableSignalColor = strongBuySignal ? deepGreen : buyHoldSignal ? lightGreen : strongSellSignal ? deepRed : sellHoldSignal ? lightRed : reversalSignal ? reversalColor : holdSignal ? holdColor : neutralColor
barcolor(colorPriceBars ? barSignalColor : na)

currentSignal = strongBuySignal ? "Strong Buy" : buyHoldSignal ? "Buy / Hold" : strongSellSignal ? "Strong Sell" : sellHoldSignal ? "Sell / Hold" : reversalSignal ? "Reversal Risk" : holdSignal ? "Hold / Consolidation" : "Neutral"
currentBias = trendState == 1 ? "Bullish" : trendState == -1 ? "Bearish" : "Neutral"

plot(trendState, title="Trend State", display=display.data_window)
plot(adxValue, title="ADX", display=display.data_window)
plot(haBodyPercent, title="HA Body %", display=display.data_window)

alertcondition(strongBuySignal, title="HADC Strong Buy", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"BUY","signal":"Strong Buy B","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')
alertcondition(buyHoldSignal, title="HADC Buy Hold", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"HOLD_LONG","signal":"Buy/Hold B","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')
alertcondition(strongSellSignal, title="HADC Strong Sell", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"SELL","signal":"Strong Sell S","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')
alertcondition(sellHoldSignal, title="HADC Sell Hold", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"HOLD_SHORT","signal":"Sell/Hold S","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')
alertcondition(holdSignal, title="HADC Hold / Partial Profit", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"PARTIAL_PROFIT","signal":"Hold H","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')
alertcondition(reversalSignal, title="HADC Reversal Risk", message='{"ticker":"{{ticker}}","exchange":"{{exchange}}","action":"REDUCE_OR_EXIT","signal":"Reversal R","strategy":"HADC HA Swing Signals","price":"{{close}}","timeframe":"{{interval}}","timestamp":"{{timenow}}"}')

if showStatusTable
    var table statusTable = table.new(position.top_right, 2, 5, border_width=1)
    if barstate.islast
        table.cell(statusTable, 0, 0, "Signal", text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 1, 0, currentSignal, text_color=color.white, bgcolor=tableSignalColor)
        table.cell(statusTable, 0, 1, "Bias", text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 1, 1, currentBias, text_color=color.white, bgcolor=trendState == 1 ? deepGreen : trendState == -1 ? deepRed : neutralColor)
        table.cell(statusTable, 0, 2, "ADX", text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 1, 2, str.tostring(adxValue, "#.##"), text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 0, 3, "HA Body %", text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 1, 3, str.tostring(haBodyPercent, "#.##"), text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 0, 4, "TF", text_color=color.white, bgcolor=color.rgb(35, 35, 35))
        table.cell(statusTable, 1, 4, signalTimeframe, text_color=color.white, bgcolor=color.rgb(35, 35, 35))
